{
  "name": "agent-server",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.1",
  "workspaces": {
    "packages": ["apps/*", "packages/*"],
    "catalog": {
      "zod": "^4.4.3",
      "drizzle-orm": "^0.45.2",
      "typescript": "~6.0.2",
      "fastify": "^5.2.1",
      "oxlint": "^1.76.0"
    }
  },
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "build": "bun run --filter '*' build",
    "lint": "bun run --filter '*' lint",
    "test": "bun run --filter '*' test",
    "typecheck": "bun run --filter '*' typecheck",
    "check": "bun run lint && bun run typecheck && bun run test",
    "test:coverage": "bun run --filter server test:coverage && bun run --filter web test:coverage",
    "test:smoke": "AGENT_SERVER_RUN_CURSOR_SMOKE=1 bun --filter server test src/smoke",
    "db:generate": "bun run --filter server db:generate",
    "catalog:codegen": "bun run --filter server catalog:codegen"
  },
  "devDependencies": {
    "oxlint": "catalog:",
    "oxlint-tsgolint": "^7.0.2001"
  }
}
