{
  "name": "@codenamegary/harold",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "bin": {
    "harold": "./apps/server/src/main.ts"
  },
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "zod": "^4.4.3",
      "drizzle-orm": "^0.45.2",
      "typescript": "~6.0.2",
      "fastify": "^5.2.1",
      "oxlint": "^1.76.0"
    }
  },
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "build": "bun run --filter '*' build",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "bun run --filter '*' lint",
    "test": "bun run --filter '*' test",
    "typecheck": "bun run --filter '*' typecheck",
    "check": "bun run lint && bun run typecheck && bun run test",
    "test:coverage": "bun run --filter server test:coverage && bun run --filter web test:coverage",
    "test:smoke": "HAROLD_RUN_SMOKE=1 bun --filter server test:smoke",
    "db:generate": "bun run --filter server db:generate",
    "catalog:codegen": "bun run --filter server catalog:codegen",
    "build:release": "bun run --filter web build && bun run --filter server build:release",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "oxfmt": "^0.68.0",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "^7.0.2001"
  }
}
