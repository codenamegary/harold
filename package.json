{
  "name": "harold-monorepo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "zod": "^4.4.3",
      "drizzle-orm": "^0.45.2",
      "typescript": "~6.0.2",
      "fastify": "^5.2.1",
      "oxlint": "^1.87.0"
    }
  },
  "scripts": {
    "dev": "bun run apps/cli/src/main.ts",
    "build": "bun run --filter '*' build",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "bun run --filter '*' lint",
    "lint:boundaries": "depcruise apps/server/src packages/core/src apps/cli/src",
    "test": "bun run --filter '*' test",
    "typecheck": "bun run --filter '*' typecheck",
    "check": "bun run lint && bun run lint:boundaries && bun run typecheck && bun run test && bun test scripts",
    "test:coverage": "bun run --filter server --filter @codenamegary/harold test:coverage",
    "test:smoke": "HAROLD_RUN_SMOKE=1 bun --filter server test:smoke",
    "db:generate": "bun run --filter server db:generate",
    "catalog:codegen": "bun run --filter core catalog:codegen",
    "build:npm": "bun run --filter @codenamegary/harold build:npm",
    "prepare": "husky"
  },
  "devDependencies": {
    "@swc/core": "^1.16.2",
    "dependency-cruiser": "^18.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "oxc-parser": "^0.150.0",
    "oxfmt": "^0.68.0",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "^7.0.2003"
  }
}
