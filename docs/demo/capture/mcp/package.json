{
  "name": "harold-probe-mcp",
  "private": true,
  "type": "module",
  "description": "MCP control plane for the Harold debug app. Wraps the on-device probe in agent-callable tools.",
  "scripts": {
    "start": "bun run src/server.ts",
    "poc": "bun run src/poc.ts",
    "smoke": "bun run src/smoke.ts",
    "walk": "bun run src/walk.ts",
    "slices": "bun run src/slices.ts --names",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
