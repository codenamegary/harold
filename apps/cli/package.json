{
  "name": "@codenamegary/harold",
  "description": "Hark! The Harold Agents Sing - Access your agents on Android from anywhere.",
  "version": "1.3.0",
  "type": "module",
  "bin": {
    "harold": "./src/main.ts"
  },
  "scripts": {
    "dev": "bun run src/main.ts",
    "start": "bun run src/main.ts",
    "build:npm": "bun run src/publish/build.npm.cli.ts",
    "lint": "oxlint --deny-warnings",
    "typecheck": "tsc -b tsconfig.app.json --noEmit",
    "test": "NODE_ENV=test bun test --parallel=4 --timeout 20000",
    "test:coverage": "NODE_ENV=test bun test --parallel=4 --timeout 20000 --coverage --coverage-reporter=lcov --coverage-dir=../../coverage/cli"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "commander": "^15.0.0",
    "contracts": "workspace:*",
    "core": "workspace:*",
    "picocolors": "^1.1.1",
    "qrcode": "^1.5.4",
    "server": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "bun-types": "^1.3.1",
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "yaml": "^2.9.0"
  }
}
