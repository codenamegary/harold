{
  "name": "server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "bun run src/main.ts",
    "start": "bun run src/main.ts",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "test": "NODE_ENV=test bun test",
    "db:generate": "sh -c 'test -n \"$1\" || { echo \"Usage: bun run db:generate <migration_name>\"; exit 1; }; bun --bun drizzle-kit generate --name=$1' --"
  },
  "dependencies": {
    "contracts": "workspace:*",
    "drizzle-orm": "catalog:",
    "fastify": "catalog:",
    "ulid": "^3.0.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "bun-types": "^1.3.1",
    "drizzle-kit": "^0.31.10",
    "oxlint": "catalog:",
    "test-support": "workspace:*",
    "typescript": "catalog:"
  }
}
