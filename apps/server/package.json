{
  "name": "server",
  "private": true,
  "version": "0.2.1",
  "type": "module",
  "scripts": {
    "dev": "bun run src/main.ts",
    "start": "bun run src/main.ts",
    "lint": "oxlint --deny-warnings",
    "typecheck": "tsc -b tsconfig.app.json --noEmit",
    "test": "NODE_ENV=test bun test --parallel=4 --timeout 20000",
    "test:smoke": "NODE_ENV=test bun test --parallel=1 --timeout 240000 src/smoke",
    "test:coverage": "NODE_ENV=test bun test --parallel=4 --timeout 20000 --coverage --coverage-reporter=lcov --coverage-dir=../../coverage/server",
    "db:generate": "sh -c 'test -n \"$1\" || { echo \"Usage: bun run db:generate <migration_name>\"; exit 1; }; bun --bun drizzle-kit generate --name=$1' --",
    "codegen:migrations": "bun run src/persistence/migrations/migrations.codegen.cli.ts",
    "build:release": "bun run codegen:migrations && bun run src/bootstrap/compile.binaries.cli.ts"
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.1",
    "@fastify/websocket": "^11.3.0",
    "contracts": "workspace:*",
    "drizzle-orm": "catalog:",
    "fastify": "catalog:",
    "ulid": "^3.0.2",
    "yaml": "^2.9.0",
    "zod": "catalog:",
    "core": "workspace:*"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1",
    "bun-types": "^1.3.1",
    "drizzle-kit": "^0.31.10",
    "oxlint": "catalog:",
    "test-support": "workspace:*",
    "typescript": "catalog:"
  },
  "exports": {
    "./bootstrap": "./src/bootstrap/run.server.ts",
    "./config": "./src/config/config.ts",
    "./database": "./src/persistence/database.ts",
    "./agent-settings/sqlite-adapters": "./src/agent-settings/agent.settings.sqlite.adapters.ts",
    "./agent-settings/catalog.sqlite.adapters": "./src/acp/catalog/catalog.sqlite.adapters.ts",
    "./device": "./src/device/device.assembly.ts",
    "./runtime-settings": "./src/runtime-settings/runtime-settings.file.adapters.ts",
    "./filesystem": "./src/filesystem/filesystem.node.adapters.ts",
    "./workspace": "./src/workspace/workspace.assembly.ts",
    "./status-summary": "./src/status/status.summary.adapters.ts",
    "./filesystem/node-adapters": "./src/filesystem/filesystem.node.adapters.ts",
    "./runtime-settings/file-store": "./src/runtime-settings/runtime-settings.file.adapters.ts",
    "./runtime-settings/update.usecase": "./src/runtime-settings/runtime-settings.update.usecase.ts"
  }
}
