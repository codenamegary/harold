    <string name="ssh_auth_help">Help</string>
    <string name="ssh_auth_help_title">SSH credentials on this device</string>
    <string name="ssh_auth_help_intro">Harold Direct signs in to your host with the credential you choose here.</string>
    <string name="ssh_auth_help_storage_title">Where it is stored</string>
    <string name="ssh_auth_help_storage_body">Your SSH key or password is stored in the encrypted list of saved connections on this phone. Android Keystore protects the encryption key. Your credentials are not written to logs.</string>
    <string name="ssh_auth_help_privacy_title">It does not go to Harold</string>
    <string name="ssh_auth_help_privacy_body">Harold never uploads or transmits your SSH credentials to a Harold server. In direct mode there is no Harold server in the path. The credential is used only in the SSH session with the host you entered. Your public key is the only part you share with the host.</string>
    <string name="ssh_auth_help_choose_title">Which option should I use?</string>
    <string name="ssh_auth_help_generate_title">Generate key (recommended)</string>
    <string name="ssh_auth_help_generate_body">Creates an Ed25519 key on this phone. Add the public key to ~/.ssh/authorized_keys on the host. Best when you want a device-specific key and no password stored.</string>
    <string name="ssh_auth_help_import_title">Import key</string>
    <string name="ssh_auth_help_import_body">Use an existing OpenSSH private key. Useful when you already manage keys or need to reuse a specific identity. The private key is stored in the encrypted list of saved connections.</string>
    <string name="ssh_auth_help_password_title">Password</string>
    <string name="ssh_auth_help_password_body">Use the SSH password for this connection. Easiest for a quick setup. The password is stored encrypted on the phone and is sent to the host only during SSH authentication. Prefer a key when the host supports one.</string>
    <string name="ssh_auth_help_pinning_title">Host key pinning</string>
    <string name="ssh_auth_help_pinning_body">On the first connection, Harold shows the host key fingerprint. It pins that key and refuses to connect if the host key changes later.</string>
    <string name="ssh_auth_help_close">Got it</string>
