{
  "$schema": "../../node_modules/oxlint/configuration_schema.json",
  "extends": ["../../.oxlintrc.json"],
  "plugins": ["react"],
  "jsPlugins": ["oxlint-tailwindcss"],
  "settings": {
    "tailwindcss": {
      "entryPoint": "./src/index.css"
    }
  },
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }],
    "tailwindcss/no-unknown-classes": "error",
    "tailwindcss/no-restricted-classes": [
      "error",
      {
        "patterns": [
          {
            "pattern": "(^|:)(text|bg|border|ring|fill|decoration|outline)-(slate|gray|zinc|neutral|stone|red|orange|yellow|green|emerald|teal|cyan|blue|indigo|purple|fuchsia|pink|rose)-",
            "message": "Use a theme token from index.css @theme"
          }
        ]
      }
    ],
    "tailwindcss/no-arbitrary-value": [
      "error",
      {
        "allow": [
          "grid-cols-",
          "grid-rows-",
          "transition-[",
          "w-[min(",
          "w-[calc(",
          "px-[max(",
          "bg-[linear-gradient(",
          "content-"
        ]
      }
    ]
  }
}
