{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun --hot dev.ts",
    "build": "tsc -b tsconfig.app.json tsconfig.node.json && bun run build.ts",
    "lint": "oxlint --deny-warnings",
    "typecheck": "tsc -b tsconfig.app.json tsconfig.node.json --noEmit",
    "test": "bun test",
    "test:coverage": "bun test --coverage --coverage-reporter=lcov --coverage-dir=../../coverage/web",
    "check": "bun run lint && bun run typecheck && bun run test"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@headlessui/react": "^2.2.10",
    "@hookform/resolvers": "5.7.1",
    "@tanstack/react-query": "^5.101.4",
    "contracts": "workspace:*",
    "jotai": "^2.20.2",
    "lucide-react": "^1.30.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "7.85.0",
    "react-router": "^7.9.4",
    "streamdown": "^2.5.0",
    "tailwindcss": "^4.3.3",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.11.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "bun-plugin-tailwind": "^0.1.2",
    "bun-types": "^1.3.1",
    "happy-dom": "^20.11.1",
    "oxlint": "catalog:",
    "typescript": "catalog:"
  }
}
