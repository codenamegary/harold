{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": false,
  "printWidth": 100,
  "tabWidth": 2,
  "singleQuote": false,
  "trailingComma": "all",
  "sortPackageJson": false,
  "ignorePatterns": [
    "packages/core/src/agent-catalog/generated",
    "packages/core/src/agent-catalog/registry.snapshot.json",
    "bun.lock",
    "skills-lock.json",
    ".agents",
    "prototype"
  ]
}
